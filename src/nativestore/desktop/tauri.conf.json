{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NativeStore",
  "version": "0.1.0",
  "identifier": "dev.nativestore.app",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; object-src 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
